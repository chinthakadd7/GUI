<Window x:Class="DesktopApp.CabinUpdates"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="CabinUpdates" Height="575" Width="800"
        Loaded="Window_Loaded"
        Background="SkyBlue" >
     

    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF0778A6" Offset="0.354"/>
                <GradientStop Color="White" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="Black" Grid.Row="0" VerticalAlignment="Top" Height="60" Opacity="0.9" BorderBrush="Black">
            <TextBlock Text="LuxStay Resort" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="1"  FontFamily="Georgia"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <DataGrid x:Name="CabinDataGrid"
          Grid.Column="0"
          Margin="30,76,36,91"
          AutoGenerateColumns="True"
          IsReadOnly="True"
          AlternatingRowBackground="White"
          
          FontSize="14" SelectionChanged="CabinDataGrid_SelectionChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,467,0,35" Width="288">
            <Button Content="Back" Click="BackButton_Click" Width="80" Margin="5" Background="#FFB6FFCA" FontFamily="Bodoni MT" FontSize="16"/>
            <Button Content="Edit" Click="Edit_Click" Width="80" Margin="5" Background="#FFD3EEFF" FontFamily="Bodoni MT" FontSize="16"/>
            <Button Content="Reload" Click="Reload_Click" Width="80" Margin="5" Background="#FFD3EEFF" FontFamily="Bodoni MT" FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>
