<Window x:Class="DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="450" Width="800"
        Background="Snow">
    <Grid>
        <Border BorderThickness="2" BorderBrush="CornflowerBlue" CornerRadius="10" Padding="20" 
        Background="White" Margin="466,25,25,25">
            <StackPanel Margin="0,74,15,3" RenderTransformOrigin="0.517,0.875">

                 
                <Label Content="Username" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Foreground="DarkSlateBlue" 
                       FontFamily="Georgia" />
                <TextBox Name="UsernameTextBox" 
                         Height="30" 
                         Margin="0,0,0,10" 
                         Padding="5" />

                 
                <Label Content="Password" 
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="DarkSlateBlue" 
                       FontFamily="Georgia" />
                
                <PasswordBox Name="PasswordBox" Height="30" Margin="0,0,0,20" Padding="5"  />
                <Button Content="Login"
                        Height="31" 
                        Background="DarkSlateBlue" 
                        Foreground="White" 
                        FontFamily="Georgia"
                        FontWeight="Bold" 
                        Padding="5" Click="LoginButton_Click" 
                        Width="255" FontSize="14"/>

                
            </StackPanel>
        </Border >

        <Border BorderThickness="2" CornerRadius="38" Padding="0"   Margin="31,25,356,25" ClipToBounds="True">
            <Image x:Name="myImage" Source="/Image/image2.jpg" Stretch="UniformToFill" Margin="-2,-2,11,-10" >
                <Image.Clip>
                    <RectangleGeometry Rect="0,0,800,450" RadiusX="38" RadiusY="38"/>
                </Image.Clip>
            </Image>
        </Border>

        <TextBlock Text="LuxStay Resort" 
                   Width="153" Height="30" 
                   HorizontalAlignment="Left"  
                   VerticalAlignment="Top" 
                   Margin="544,73,0,0" 
                   FontFamily="Georgia"
                   Foreground="DarkSlateBlue"
   FontSize="22"/>
    </Grid>
</Window>
